# Aaliis Pharmaceuticals - Environment Variables Template
# Copy this file to .env.local and configure your credentials.
# NEVER commit real credentials or .env.local to Git.

# Resend API Key for server-side transactional email delivery
RESEND_API_KEY=your_resend_api_key_here

# Recipient email for commercial business & PCD franchise enquiries
ENQUIRY_TO_EMAIL=aaliispharma2025@gmail.com

# Sender email address
# For initial testing before custom domain verification, use Resend's testing sender:
# RESEND_FROM_EMAIL=Aaliis Pharmaceuticals <onboarding@resend.dev>
# For production with verified domain (e.g. aaliispharma.com):
# RESEND_FROM_EMAIL=Aaliis Pharmaceuticals <enquiry@aaliispharma.com>
RESEND_FROM_EMAIL=Aaliis Pharmaceuticals <onboarding@resend.dev>

# Production site URL
NEXT_PUBLIC_SITE_URL=https://aaliispharma.com

